datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id          String       @id @default(uuid())
  email       String       @unique
  password    String
  name        String
  role        String       @default("STUDENT") // "STUDENT" | "ADMIN"
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  enrollments Enrollment[]
  progresses  Progress[]
  reviews     Review[]
  payments    Payment[]
}

model Category {
  id      String   @id @default(uuid())
  name    String   @unique
  slug    String   @unique
  courses Course[]
}

model Course {
  id           String       @id @default(uuid())
  title        String
  description  String
  price        Float        @default(0.0)
  thumbnail    String?
  categoryId   String
  category     Category     @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  instructorId String
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  lessons      Lesson[]
  enrollments  Enrollment[]
  reviews      Review[]
  payments     Payment[]
}

model Lesson {
  id           String     @id @default(uuid())
  title        String
  content      String?
  videoUrl     String?
  platformType String     @default("youtube") // "youtube" | "secure"
  libraryId    String?
  duration     Int        @default(0) // in seconds
  courseId     String
  course       Course     @relation(fields: [courseId], references: [id], onDelete: Cascade)
  order        Int        @default(0)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  progresses   Progress[]
}

model Enrollment {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseId  String
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, courseId])
}

model Progress {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  lessonId  String
  lesson    Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  completed Boolean  @default(false)
  updatedAt DateTime @updatedAt

  @@unique([userId, lessonId])
}

model Review {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseId  String
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  rating    Int      @default(5)
  comment   String
  createdAt DateTime @default(now())

  @@unique([userId, courseId])
}

model Payment {
  id            String   @id @default(uuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseId      String
  course        Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  amount        Float
  status        String   @default("PENDING") // "PENDING" | "SUCCESS" | "FAILED"
  transactionId String   @unique
  createdAt     DateTime @default(now())
}
